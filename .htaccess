# Mengaktifkan URL Rewrite
RewriteEngine On

# Redirect semua HTTP ke HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Menentukan file default (index.php)
DirectoryIndex index.php

# Mencegah akses langsung ke file sensitif
<FilesMatch "(\.env|config\.php|composer\.(json|lock)|\.htaccess)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Menangani Error Pages
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html

# Memblokir direktori agar tidak ditampilkan
Options -Indexes

# Cache control untuk meningkatkan performa
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
